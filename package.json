{
  "name": "libretv",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "description": "免费在线视频搜索与观看平台",
  "author": "bestZwei",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "nodemon server.mjs",
    "start": "node server.mjs",
    "build": "npm run build:core",
    "build:core": "esbuild src/core/index.ts --bundle --format=esm --platform=browser --target=es2020 --sourcemap --outfile=js/liberty-core.js && node scripts/generate-version.mjs",
    "generate:version": "node scripts/generate-version.mjs",
    "typecheck": "tsc --noEmit",
    "test:core": "npm run build:core && node --test test/core/*.test.js",
    "test": "npm run build:core && node --test"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.10",
    "typescript": "^7.0.2"
  }
}
